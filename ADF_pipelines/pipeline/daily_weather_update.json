								"sink": {
									"name": "eventSubmissionTime",
									"type": "DateTime"
								}
							},
							{
								"source": {
									"path": "$['versionId']"
								},
								"sink": {
									"name": "versionId",
									"type": "Int32"
								}
							},
							{
								"source": {
									"path": "$['link']"
								},
								"sink": {
									"name": "eventLink",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "['isMostAccurate']"
								},
								"sink": {
									"name": "isMostAccurate",
									"type": "Boolean"
								}
							},
							{
								"source": {
									"path": "['time21_5']"
								},
								"sink": {
									"name": "time21_5",
									"type": "DateTime"
								}
							},
							{
								"source": {
									"path": "['latitude']"
								},
								"sink": {
									"name": "latitude",
									"type": "Double"
								}
							},
							{
								"source": {
									"path": "['longitude']"
								},
								"sink": {
									"name": "longitude",
									"type": "Double"
								}
							},
							{
								"source": {
									"path": "['halfAngle']"
								},
								"sink": {
									"name": "halfAngle",
									"type": "Double"
								}
							},
							{
								"source": {
									"path": "['speed']"
								},
								"sink": {
									"name": "speed",
									"type": "Double"
								}
							},
							{
								"source": {
									"path": "['type']"
								},
								"sink": {
									"name": "type",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "['note']"
