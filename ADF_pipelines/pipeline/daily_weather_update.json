							},
							{
								"source": {
									"path": "['levelOfData']"
								},
								"sink": {
									"name": "levelOfData",
									"type": "Int32"
								}
							},
							{
								"source": {
									"path": "['submissionTime']"
								},
								"sink": {
									"name": "analysisSubmissionTime",
									"type": "DateTime"
								}
							},
							{
								"source": {
									"path": "['link']"
								},
								"sink": {
									"name": "analysisLink",
									"type": "String"
								}
							}
						],
						"collectionReference": "$['cmeAnalyses']"
					}
				},
				"inputs": [
					{
						"referenceName": "RestResource1",
						"type": "DatasetReference",
						"parameters": {
							"startDate": {
								"value": "@formatDateTime(addDays(utcNow(),-1), 'yyyy-MM-dd')",
								"type": "Expression"
							},
							"endDate": {
								"value": "@formatDateTime(utcNow(), 'yyyy-MM-dd')",
								"type": "Expression"
							},
							"apiKey": {
								"value": "@activity('Get Secrets').output.value",
								"type": "Expression"
							}
						}
					}
				],
				"outputs": [
					{
						"referenceName": "stg_CME_Raw",
						"type": "DatasetReference"
					}
				]
			},
			{
				"name": "Stored procedure1",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "Copy data1",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[dbo].[normalize_CME_data]"
				},
				"linkedServiceName": {
					"referenceName": "AzureSqlDatabase1",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "Get Secrets",
				"description": "Gets the API keys from the key vault",
				"type": "WebActivity",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": true,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "GET",
					"url": "https://space-weather-keys2.vault.azure.net/secrets/NASA-DONKI?api-version=7.0",
					"authentication": {
						"type": "MSI",
						"resource": "https://vault.azure.net"
					}
				}
			}
		],
		"annotations": [],
		"lastPublishTime": "2026-07-30T19:13:09Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}