{
	"name": "daily_weather_update",
	"properties": {
		"activities": [
			{
				"name": "Copy data1",
				"description": "Copies CME data from the rest API, unrolls it, then saves it to the database's rawCME table",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "Get Secrets",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 3,
					"retryIntervalInSeconds": 300,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "RestSource",
						"httpRequestTimeout": "00:01:40",
						"requestInterval": "00.00:00:00.010",
						"requestMethod": "GET",
						"paginationRules": {
							"supportRFC5988": "true"
						}
					},
					"sink": {
						"type": "AzureSqlSink",
						"writeBehavior": "insert",
						"sqlWriterUseTableLock": false
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"mappings": [
							{
								"source": {
									"path": "$['activityID']"
								},
								"sink": {
									"name": "activityID",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "$['catalog']"
								},
								"sink": {
									"name": "catalog",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "$['startTime']"
								},
								"sink": {
									"name": "eventStartTime",
									"type": "DateTime"
								}
							},
							{
								"source": {
									"path": "$['sourceLocation']"
								},
								"sink": {
									"name": "sourceLocation",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "$['activeRegionNum']"
								},
								"sink": {
									"name": "activeRegionNum",
									"type": "Int32"
								}
							},
							{
								"source": {
									"path": "$['note']"
								},
								"sink": {
									"name": "eventNote",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "$['submissionTime']"
